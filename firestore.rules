rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.enabled == true
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.uid == request.auth.uid;
    }

    match /admins/{adminEmail} {
      // The name/ID lookup happens before password authentication.
      allow read: if true;
      // After signing in as this email, the app can bind the Auth UID once.
      allow update: if request.auth != null
        && request.auth.token.email == adminEmail
        && resource.data.email == adminEmail
        && resource.data.enabled == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.enabled == resource.data.enabled
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']);
      allow create, delete: if false;
    }

    match /sites/{siteId} {
      allow read: if true;
      allow create, update, delete: if signedInAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == reviewId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.author is string
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() > 0
          && request.resource.data.comment.size() <= 2000;
        allow delete: if signedInAdmin()
          || (request.auth != null && request.auth.uid == reviewId);
      }
    }

    // Required for the admin's collectionGroup('reviews') moderation list.
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
      allow delete: if signedInAdmin();
    }

    match /companies/{companyId} {
      allow read: if true;
      allow create, update, delete: if signedInAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || signedInAdmin());
      allow create, delete: if request.auth != null
        && request.auth.uid == userId;
      allow update: if signedInAdmin()
        || (request.auth != null
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']));

      match /bookings/{bookingId} {
        allow read, delete: if request.auth != null
          && (request.auth.uid == userId || signedInAdmin());
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.paymentStatus == 'payment_pending';
        allow update: if signedInAdmin();
      }
      match /notifications/{notificationId} {
        allow read, write: if request.auth != null
          && (request.auth.uid == userId || signedInAdmin());
      }
      match /favorites/{siteId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }
  }
}
